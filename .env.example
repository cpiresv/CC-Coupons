# Copy to .env. Never commit tokens or authenticated browser data.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ACCOUNT_1_NAME=Conta 1
ACCOUNT_2_NAME=Conta 2
ACCOUNT_3_NAME=Conta 3
DAILY_CHECK_TIME=09:00
PORT=4310
# Optional private HTTPS via Tailscale Serve; binds the server to localhost.
# TAILSCALE_HOST=your-mac.your-tailnet.ts.net
# Installed Chrome avoids a separate Chromium download.
BROWSER_CHANNEL=chrome
HEADLESS=true
# DATA_DIR defaults to ./data, resolved relative to this project.
